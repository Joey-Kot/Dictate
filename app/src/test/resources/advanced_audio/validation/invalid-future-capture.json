{
  "schema_version": 2,
  "name": "Capture cannot be read by its defining stage",
  "parameters": [
    {
      "id": "model",
      "label": "Model",
      "default": "asr",
      "type": "text"
    }
  ],
  "audio": {
    "delivery": {
      "type": "base64"
    }
  },
  "recognition": {
    "mode": "request",
    "request": {
      "method": "POST",
      "url": "https://asr.example.test/v1/tasks/{{capture:job_id}}",
      "body": {
        "type": "json",
        "value": {
          "model": "{{var:model}}",
          "audio": "{{audio:base64}}"
        }
      },
      "captures": [
        {
          "id": "job_id",
          "from": {
            "type": "json_path",
            "path": "$.job_id"
          }
        }
      ]
    },
    "final_text": {
      "type": "json_path",
      "path": "$.text"
    }
  }
}
